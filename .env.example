# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  IndyForge — Configuration                                                 ║
# ║  Copy this file to .env and customize it.                                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ──────────────────────────────────────────────────────────────────────────────
# 1. LLM PROVIDER
# ──────────────────────────────────────────────────────────────────────────────
# Which LLM backend to use. All models below must be compatible with
# the chosen provider.
#
# Supported values:
#   ollama      — Local models via Ollama (default, no API key needed)
#   openai      — OpenAI API (requires OPENAI_API_KEY)
#   anthropic   — Anthropic Claude API (requires ANTHROPIC_API_KEY)
#   groq        — Groq cloud inference (requires GROQ_API_KEY)
#   azure       — Azure OpenAI (requires AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT)
#
INDYFORGE_PROVIDER=ollama


# ──────────────────────────────────────────────────────────────────────────────
# 2. API KEYS (only needed for cloud providers, ignore if using ollama)
# ──────────────────────────────────────────────────────────────────────────────
# Uncomment and fill the keys for your chosen provider:
#
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/


# ──────────────────────────────────────────────────────────────────────────────
# 3. PER-AGENT MODEL SELECTION
# ──────────────────────────────────────────────────────────────────────────────
# IndyForge uses 4 specialized agents. You can assign a different model
# to each one to optimize cost, speed, and quality.
#
# ┌─────────────────────┬──────────────────────────────────────────────────────┐
# │ Agent               │ What it does                                         │
# ├─────────────────────┼──────────────────────────────────────────────────────┤
# │ CODE_MODEL          │ Analyzes source code: dependencies, API endpoints,   │
# │                     │ events, sequences, file tree annotations             │
# ├─────────────────────┼──────────────────────────────────────────────────────┤
# │ WRITER_MODEL        │ Writes the final overview.md and system-overview.md  │
# │                     │ Needs good prose and markdown formatting skills      │
# ├─────────────────────┼──────────────────────────────────────────────────────┤
# │ SECURITY_MODEL      │ Analyzes auth, CVEs, secrets, CORS, encryption      │
# │                     │ Benefits from a model with security domain knowledge │
# ├─────────────────────┼──────────────────────────────────────────────────────┤
# │ VERIFIER_MODEL      │ Checks the overview for hallucinations and errors    │
# │                     │ Must return valid JSON — use a model with good       │
# │                     │ instruction following                                │
# └─────────────────────┴──────────────────────────────────────────────────────┘
#
# ── Example: Ollama (local, free) ────────────────────────────────────────────
# Run: ollama pull <model-name> for each model before using.
#
INDYFORGE_CODE_MODEL=deepseek-coder:6.7b
INDYFORGE_WRITER_MODEL=llama3.1:8b
INDYFORGE_SECURITY_MODEL=mistral:7b
INDYFORGE_VERIFIER_MODEL=llama3.1:8b
#
# ── Example: OpenAI ─────────────────────────────────────────────────────────
# Tip: use gpt-4o for code/writer/security, and gpt-4o-mini for verifier
# to save costs (verifier just outputs a small JSON).
#
# INDYFORGE_CODE_MODEL=gpt-4o
# INDYFORGE_WRITER_MODEL=gpt-4o
# INDYFORGE_SECURITY_MODEL=gpt-4o
# INDYFORGE_VERIFIER_MODEL=gpt-4o-mini
#
# ── Example: Anthropic ──────────────────────────────────────────────────────
# Tip: Claude Sonnet is a great balance of quality and speed.
# Use Haiku for the verifier to cut costs.
#
# INDYFORGE_CODE_MODEL=claude-sonnet-4-20250514
# INDYFORGE_WRITER_MODEL=claude-sonnet-4-20250514
# INDYFORGE_SECURITY_MODEL=claude-sonnet-4-20250514
# INDYFORGE_VERIFIER_MODEL=claude-haiku-4-20250514
#
# ── Example: Groq (fast cloud inference) ────────────────────────────────────
#
# INDYFORGE_CODE_MODEL=llama-3.1-70b-versatile
# INDYFORGE_WRITER_MODEL=llama-3.1-70b-versatile
# INDYFORGE_SECURITY_MODEL=llama-3.1-70b-versatile
# INDYFORGE_VERIFIER_MODEL=llama-3.1-8b-instant
#
# ── Example: Azure OpenAI ───────────────────────────────────────────────────
# Use your Azure deployment names (not the OpenAI model names).
#
# INDYFORGE_CODE_MODEL=my-gpt4o-deployment
# INDYFORGE_WRITER_MODEL=my-gpt4o-deployment
# INDYFORGE_SECURITY_MODEL=my-gpt4o-deployment
# INDYFORGE_VERIFIER_MODEL=my-gpt4o-mini-deployment


# ──────────────────────────────────────────────────────────────────────────────
# 4. QUICK OVERRIDE (use ONE model for everything)
# ──────────────────────────────────────────────────────────────────────────────
# If set, this overrides ALL 4 agent models above.
# Useful for quick testing or when you only have one model available.
#
# INDYFORGE_MODEL=llama3.2:3b


# ---------------------------------------------------------
# PERFORMANCE & THREADING
# ---------------------------------------------------------
# Max number of agents/repos to run in parallel.
# - If you use Cloud APIs (OpenAI/Anthropic): leave this empty (runs all 7 workers instantly).
# - If you use Local Ollama on a normal PC: set to 1 or 2 to avoid VRAM thrashing and freezing.
# INDYFORGE_MAX_CONCURRENCY=1


# ──────────────────────────────────────────────────────────────────────────────
# 5. OUTPUT LANGUAGE
# ──────────────────────────────────────────────────────────────────────────────
# Language for generated documentation and CLI messages.
# Supported: english, italian
#
INDYFORGE_LANGUAGE=english
