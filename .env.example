# IndyForge Model Configuration
# Each agent can use a different Ollama model.
# Run: ollama pull <model-name> before using.

# General purpose / writer / aggregator
INDYFORGE_WRITER_MODEL=llama3.1:8b

# Code analysis (deps, REST, sequences)
INDYFORGE_CODE_MODEL=deepseek-coder:6.7b

# Security reasoning (CVE, auth analysis)
INDYFORGE_SECURITY_MODEL=mistral:7b

# Verifier / reflection loop
INDYFORGE_VERIFIER_MODEL=llama3.1:8b

# Quick override: set this to use ONE model for everything (overrides above)
# INDYFORGE_MODEL=llama3.2:3b
